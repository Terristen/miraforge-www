---

<section class="features-band" id="features" aria-roledescription="carousel" aria-label="Studio features">
  <div class="features-bar">
    <button class="features-nav" type="button" data-features-dir="-1" aria-label="Previous feature">
      <img src="/assets/optimized/round_left__200w.webp" width="200" height="200" alt="" />
    </button>
    <div class="features" tabindex="0">
      {
        features.map((feature) => (
          <article class="feature">
            <div class="feature-body">
              <img class="feature-seal" src={feature.seal} width="200" height="200" alt="" />
              <p class="feature-label">{feature.label}</p>
              <h2 class="feature-title">{feature.title}</h2>
              <p class="feature-copy">{feature.body}</p>
            </div>
            <picture class="feature-scene">
              <source type="image/avif" srcset={`/assets/optimized/${feature.scene}__640w.avif`} />
              <source type="image/webp" srcset={`/assets/optimized/${feature.scene}__640w.webp`} />
              <img
                src={`/assets/optimized/${feature.scene}__640w.webp`}
                width={feature.sceneWidth}
                height={feature.sceneHeight}
                alt=""
                style={`object-position: ${feature.crop}`}
              />
            </picture>
          </article>
        ))
      }
    </div>
    <button class="features-nav" type="button" data-features-dir="1" aria-label="Next feature">
      <img src="/assets/optimized/round_right__200w.webp" width="200" height="200" alt="" />
    </button>
  </div>
</section>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll('.features-band').forEach((band) => {
    const scroller = band.querySelector('.features');
    const prev = band.querySelector('[data-features-dir="-1"]');
    const next = band.querySelector('[data-features-dir="1"]');
    if (!scroller || !prev || !next || scroller.dataset.ready === 'true') return;
    scroller.dataset.ready = 'true';

    const originals = [...scroller.children];
    const count = originals.length;
    const decorate = (node) => {
      node.setAttribute('aria-hidden', 'true');
      node.inert = true;
      return node;
    };
    scroller.prepend(...originals.map((card) => decorate(card.cloneNode(true))));
    scroller.append(...originals.map((card) => decorate(card.cloneNode(true))));

    const step = () => {
      const card = scroller.querySelector('.feature');
      const gap = parseFloat(getComputedStyle(scroller).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    let locking = false;
    const jump = (left) => {
      locking = true;
      const snap = scroller.style.scrollSnapType;
      scroller.style.scrollSnapType = 'none';
      scroller.scrollLeft = left;
      scroller.style.scrollSnapType = snap;
      locking = false;
    };

    const normalize = () => {
      if (locking) return;
      const distance = step();
      if (!distance) return;
      const index = Math.round(scroller.scrollLeft / distance);
      if (index < count) jump(scroller.scrollLeft + distance * count);
      else if (index >= count * 2) jump(scroller.scrollLeft - distance * count);
    };

    const move = (direction) => {
      const distance = step();
      if (!distance) return;
      scroller.scrollBy({ left: direction * distance, behavior: reduced ? 'auto' : 'smooth' });
    };

    const place = () => {
      const distance = step();
      if (!distance) {
        requestAnimationFrame(place);
        return;
      }
      jump(distance * count);
    };
    place();

    if ('onscrollend' in window) scroller.addEventListener('scrollend', normalize);
    else {
      let timer = 0;
      scroller.addEventListener('scroll', () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(normalize, 140);
      });
    }

    prev.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    scroller.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      move(event.key === 'ArrowRight' ? 1 : -1);
    });

    window.addEventListener('resize', () => {
      const distance = step();
      if (!distance) return;
      const index = Math.round(scroller.scrollLeft / distance);
      const slot = ((index % count) + count) % count;
      jump((slot + count) * distance);
    });
  });
</script>
