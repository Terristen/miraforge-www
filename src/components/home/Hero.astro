---
// Remove the high-res source import
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-stage">
  <div class="hero-copy">
    <h1 id="hero-heading">
      <span class="line">Build worlds.</span>
      <span class="line">Write stories.</span>
      <span class="line line-accent">Keep them connected.</span>
    </h1>
    <p class="hero-lead">
      Miraforge Studio is a desktop authoring environment for writers who need more than a
      document — manuscript, lore, notes, and structure together in one Archive.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary btn-brass" href="/studio/">
        Explore Studio
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn-brass-inverse" href="/docs/">Open Handbook</a>
    </div>
  </div>
  <div class="hero-visual">
    <figure class="hero-plate">
      <picture>
        <source
          type="image/avif"
          srcset="/assets/optimized/hero_3__640w.avif 640w, /assets/optimized/hero_3__1024w.avif 1024w, /assets/optimized/hero_3__1920w.avif 1920w"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1200px"
        />
        <source
          type="image/webp"
          srcset="/assets/optimized/hero_3__640w.webp 640w, /assets/optimized/hero_3__1024w.webp 1024w, /assets/optimized/hero_3__1920w.webp 1920w"
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 80vw, 1200px"
        />
        <img
          src="/assets/optimized/hero_3__1920w.webp"
          alt="Miraforge Studio open on the War Pass Archive. The manuscript editor is beside the lore list and archive files."
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </figure>
  </div>
  </div>
</section>

