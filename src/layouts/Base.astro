---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  noindex?: boolean;
}

const { title, description, home = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'Miraforge' ? title : `${title} · Miraforge`;
const image = new URL('/og.jpg', Astro.site);
const siteUrl = new URL('/', Astro.site).href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const webPage = {
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical.href,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Miraforge',
    url: siteUrl,
  },
};
const organization = {
  '@type': 'Organization',
  '@id': new URL('/#organization', Astro.site).href,
  name: 'Miraforge',
  url: siteUrl,
  description:
    'Miraforge is an independent software company building tools for writers and other creative professionals.',
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicon.jpg', Astro.site).href,
    width: 1024,
    height: 1024,
  },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': home ? [organization, webPage] : [webPage],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Miraforge" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:alt" content="Miraforge Studio. Build worlds. Write stories. Keep them connected." />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body class={home ? 'home' : undefined}>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
